SET enable_seqscan = off;
SET
SELECT id FROM rse WHERE s %~~ tre_pattern('x[[:alpha', 0);
psql:test/sql/regex_syntax_edges.sql:51: ERROR:  pg_tre: invalid regex pattern: unterminated [: in bracket expression
SELECT id FROM rse WHERE s ~ 'abc\';
psql:test/sql/regex_syntax_edges.sql:52: ERROR:  invalid regular expression: invalid escape \ sequence
