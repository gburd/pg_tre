CREATE INDEX
SELECT 'ucs_basic (column)' AS collation, * FROM cm_check('cm');
     collation      | queries | idx_ne_seq | nonempty 
--------------------+---------+------------+----------
 ucs_basic (column) |       8 |          0 |        8
