ANALYZE cp;
ANALYZE
CREATE FUNCTION cp_rows(q text, ix bool) RETURNS int[]
LANGUAGE plpgsql AS $$
DECLARE r int[];
BEGIN
  PERFORM set_config('enable_seqscan',    (NOT ix)::text, true);
  PERFORM set_config('enable_indexscan',  'off',          true);
  PERFORM set_config('enable_bitmapscan', ix::text,       true);
  EXECUTE 'SELECT array_agg(id ORDER BY id) FROM cp WHERE ' || q INTO r;
  RETURN r;
END $$;
CREATE FUNCTION
CREATE TEMP TABLE qs (q text);
CREATE TABLE
INSERT INTO qs VALUES
  ($$s ~ 'aa[bc]c'$$), ($$s ~ 'aa[bc]c[b-d]'$$), ($$s ~ '(?<=e.)aa[bc]c[b-d]'$$),
  ($$s ~ 'a[a-d][bc]c'$$), ($$s ~ '[xyz][ye ][ .]aa'$$), ($$s ~ 'aa[^b]c'$$),
  ($$s ~ 'caf[\é]'$$), ($$s %~~ tre_pattern('caf[\é]', 0)$$),
  ($$s ~ 'caf[éè]'$$), ($$s ~ 'aa[-x]c'$$), ($$s ~* 'aa[bc]c'$$),
  ($$s %~~ tre_pattern('postgresql', 1)$$), ($$s %~~ tre_pattern('postgresql', 2)$$),
  ($$s %~~ tre_pattern('quick brown', 2)$$), ($$s %~~ tre_pattern('quick brown fox', 3)$$),
  ($$s %~~ tre_pattern('développement', 1)$$), ($$s %~~ tre_pattern('développement', 2)$$),
  ($$s %~~ tre_pattern('postgres(ql|QL)', 1)$$), ($$s %~~ tre_pattern('post.resql', 1)$$),
  ($$s %~~ tre_pattern('mysql', 1)$$), ($$s %~~ tre_pattern('postgresql', 1, 1, 1, 0)$$);
