-- The filters engage (no lossy whole-table scan).
SELECT p, k, split_part(tre_extract_debug(p, k), E'\n', 1) AS mode,
       tre_extract_debug(p, k) NOT LIKE '%ALWAYS_TRUE%' AS filtered
  FROM (VALUES ('aa[bc]c[b-d]', 0), ('(?<=e.)aa[bc]c[b-d]', 0),
               ('postgresql', 1), ('quick brown fox', 3),
               ('développement', 2), ('mysql', 1)) v(p, k);
          p          | k |      mode       | filtered 
---------------------+---+-----------------+----------
