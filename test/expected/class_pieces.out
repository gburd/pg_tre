 (?<=e.)aa[bc]c[b-d] | 0 | k=0 mode=CNF    | t
 postgresql          | 1 | k=1 mode=PIECES | t
 quick brown fox     | 3 | k=3 mode=PIECES | t
 développement       | 2 | k=2 mode=PIECES | t
 mysql               | 1 | k=1 mode=CNF    | f
