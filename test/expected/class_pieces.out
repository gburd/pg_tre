-- test/sql/class_pieces.sql
--
-- Two trigram filters added in 4.3.1, both checked against a seq scan:
--
-- 1. A small character class in a literal run is a position of
--    alternatives: 'aa[bc]c' requires (aab | aac) AND (abc | acc) instead
--    of giving up on the whole pattern.  depesz's blog post compared
--    '(?<=e.)aa[bc]c[b-d]': pg_trgm narrowed it to 5177 rows, pg_tre read
--    every row.  A backslash inside a bracket is opaque: core reads an
--    escape there, TRE a literal backslash ('[\é]' matches 'caf\').
--
-- 2. Fuzzy patterns (k >= 1) long enough to cut into k+1 pieces of three
--    characters use the pigeonhole on pieces: a match within k edits
--    keeps at least one piece intact, so the filter is OR over pieces of
--    the AND of each piece's trigrams -- exact trigrams only.  Before,
--    every trigram's edit neighbourhood was unioned, which in a UTF-8
--    database left 'postgresql' at k=1 reading the whole table.
CREATE EXTENSION IF NOT EXISTS pg_tre;
psql:test/sql/class_pieces.sql:19: NOTICE:  extension "pg_tre" already exists, skipping
CREATE EXTENSION
SET client_min_messages = warning;
SET
