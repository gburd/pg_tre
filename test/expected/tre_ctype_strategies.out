SELECT tre_amatch('é', '^[[:alpha:]]$', 0) AS alpha_e, 'é' ~ '^[[:alpha:]]$' AS core,
       tre_amatch('É', '(?i)^é$', 0) AS fold_e, 'É' ~* '^é$' AS core_fold;
alpha_e|core|fold_e|core_fold
